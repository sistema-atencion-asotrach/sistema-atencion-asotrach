# Copie este archivo como .env (Docker) o defina estas variables en su servidor.
PORT=3000
# Correo y contraseña del primer administrador (solo se usan si la base de datos está vacía).
ADMIN_EMAIL=admin@su-entidad.gov.co
ADMIN_PASSWORD=cambie-esta-contraseña-ahora
# Poner en 1 cuando el sistema esté detrás de un proxy con HTTPS (Caddy, Nginx, Render, etc.).
TRUST_PROXY=1
# Zona horaria usada para contar los días hábiles.
TZ_ENTIDAD=America/Bogota
# Carpeta donde se guardan la base de datos y los adjuntos.
DATA_DIR=/app/data
